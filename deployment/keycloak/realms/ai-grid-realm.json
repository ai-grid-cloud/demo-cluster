{
  "realm": "ai-grid",
  "enabled": true,
  "organizationsEnabled": true,
  "bruteForceProtected": true,
  "permanentLockout": false,
  "failureFactor": 10,
  "waitIncrementSeconds": 60,
  "maxFailureWaitSeconds": 900,
  "organizations": [
    {
      "id": "6c0e9545-c68e-448e-bd38-a4cca32e963a",
      "name": "org1",
      "alias": "org1",
      "enabled": true,
      "domains": [
        {
          "name": "org1.example.com"
        }
      ],
      "identityProviders": [
        {
          "alias": "org1-idp"
        }
      ]
    },
    {
      "id": "f482cdb6-4658-480b-add6-0464f8d93461",
      "name": "org2",
      "alias": "org2",
      "enabled": true,
      "domains": [
        {
          "name": "org2.example.com"
        }
      ],
      "identityProviders": [
        {
          "alias": "org2-idp"
        }
      ]
    },
    {
      "id": "4f8f7064-3a78-4914-8187-fe4e8536a1f4",
      "name": "org3",
      "alias": "org3",
      "enabled": true,
      "domains": [
        {
          "name": "chris.example.com"
        }
      ]
    }
  ],
  "identityProviders": [
    {
      "alias": "org1-idp",
      "displayName": "org1",
      "providerId": "oidc",
      "enabled": true,
      "hideOnLogin": true,
      "trustEmail": false,
      "firstBrokerLoginFlowAlias": "ai-grid first broker login",
      "config": {
        "clientId": "ai-grid-broker",
        "clientSecret": "${ORG1_BROKER_SECRET}",
        "clientAuthMethod": "client_secret_post",
        "issuer": "${KEYCLOAK_PUBLIC_URL}/realms/org1-idp",
        "authorizationUrl": "${KEYCLOAK_PUBLIC_URL}/realms/org1-idp/protocol/openid-connect/auth",
        "tokenUrl": "${KEYCLOAK_PUBLIC_URL}/realms/org1-idp/protocol/openid-connect/token",
        "jwksUrl": "${KEYCLOAK_PUBLIC_URL}/realms/org1-idp/protocol/openid-connect/certs",
        "logoutUrl": "${KEYCLOAK_PUBLIC_URL}/realms/org1-idp/protocol/openid-connect/logout",
        "useJwksUrl": "true",
        "validateSignature": "true",
        "pkceEnabled": "true",
        "pkceMethod": "S256",
        "defaultScope": "openid email profile",
        "syncMode": "FORCE",
        "kc.org.domain": "org1.example.com",
        "kc.org.broker.redirect.mode.email-matches": "true"
      }
    },
    {
      "alias": "org2-idp",
      "displayName": "org2",
      "providerId": "oidc",
      "enabled": true,
      "hideOnLogin": true,
      "trustEmail": false,
      "firstBrokerLoginFlowAlias": "ai-grid first broker login",
      "config": {
        "clientId": "ai-grid-broker",
        "clientSecret": "${ORG2_BROKER_SECRET}",
        "clientAuthMethod": "client_secret_post",
        "issuer": "${KEYCLOAK_PUBLIC_URL}/realms/org2-idp",
        "authorizationUrl": "${KEYCLOAK_PUBLIC_URL}/realms/org2-idp/protocol/openid-connect/auth",
        "tokenUrl": "${KEYCLOAK_PUBLIC_URL}/realms/org2-idp/protocol/openid-connect/token",
        "jwksUrl": "${KEYCLOAK_PUBLIC_URL}/realms/org2-idp/protocol/openid-connect/certs",
        "logoutUrl": "${KEYCLOAK_PUBLIC_URL}/realms/org2-idp/protocol/openid-connect/logout",
        "useJwksUrl": "true",
        "validateSignature": "true",
        "pkceEnabled": "true",
        "pkceMethod": "S256",
        "defaultScope": "openid email profile",
        "syncMode": "FORCE",
        "kc.org.domain": "org2.example.com",
        "kc.org.broker.redirect.mode.email-matches": "true"
      }
    }
  ],
  "groups": [
    {
      "name": "6c0e9545-c68e-448e-bd38-a4cca32e963a",
      "subGroups": [
        {
          "name": "group1",
          "attributes": {
            "maas_groups": [
              "6c0e9545-c68e-448e-bd38-a4cca32e963a/group1"
            ]
          }
        }
      ]
    },
    {
      "name": "f482cdb6-4658-480b-add6-0464f8d93461",
      "subGroups": [
        {
          "name": "group1",
          "attributes": {
            "maas_groups": [
              "f482cdb6-4658-480b-add6-0464f8d93461/group1"
            ]
          }
        }
      ]
    }
  ],
  "identityProviderMappers": [
    {
      "name": "username",
      "identityProviderAlias": "org1-idp",
      "identityProviderMapper": "oidc-username-idp-mapper",
      "config": {
        "template": "${ALIAS}.${CLAIM.sub}",
        "syncMode": "FORCE"
      }
    },
    {
      "name": "username",
      "identityProviderAlias": "org2-idp",
      "identityProviderMapper": "oidc-username-idp-mapper",
      "config": {
        "template": "${ALIAS}.${CLAIM.sub}",
        "syncMode": "FORCE"
      }
    },
    {
      "name": "organization",
      "identityProviderAlias": "org1-idp",
      "identityProviderMapper": "hardcoded-attribute-idp-mapper",
      "config": {
        "attribute": "maas_orgs",
        "attribute.value": "[{\"organization_id\":\"6c0e9545-c68e-448e-bd38-a4cca32e963a\",\"organization_name\":\"org1\",\"roles\":[\"member\"]}]",
        "syncMode": "FORCE"
      }
    },
    {
      "name": "group1",
      "identityProviderAlias": "org1-idp",
      "identityProviderMapper": "oidc-advanced-group-idp-mapper",
      "config": {
        "claims": "[{\"key\":\"groups\",\"value\":\"group1\"}]",
        "are.claim.values.regex": "false",
        "group": "/6c0e9545-c68e-448e-bd38-a4cca32e963a/group1",
        "syncMode": "FORCE"
      }
    },
    {
      "name": "organization",
      "identityProviderAlias": "org2-idp",
      "identityProviderMapper": "hardcoded-attribute-idp-mapper",
      "config": {
        "attribute": "maas_orgs",
        "attribute.value": "[{\"organization_id\":\"f482cdb6-4658-480b-add6-0464f8d93461\",\"organization_name\":\"org2\",\"roles\":[\"member\"]}]",
        "syncMode": "FORCE"
      }
    },
    {
      "name": "group1",
      "identityProviderAlias": "org2-idp",
      "identityProviderMapper": "oidc-advanced-group-idp-mapper",
      "config": {
        "claims": "[{\"key\":\"groups\",\"value\":\"group1\"}]",
        "are.claim.values.regex": "false",
        "group": "/f482cdb6-4658-480b-add6-0464f8d93461/group1",
        "syncMode": "FORCE"
      }
    }
  ],
  "authenticationFlows": [
    {
      "alias": "ai-grid first broker login",
      "description": "Create the brokered user if unique, then add them to the provider's organization",
      "providerId": "basic-flow",
      "topLevel": true,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticator": "idp-create-user-if-unique",
          "requirement": "REQUIRED",
          "priority": 10,
          "authenticatorFlow": false,
          "userSetupAllowed": false
        },
        {
          "authenticator": "idp-add-organization-member",
          "requirement": "REQUIRED",
          "priority": 20,
          "authenticatorFlow": false,
          "userSetupAllowed": false
        }
      ]
    }
  ],
  "clientScopes": [
    {
      "name": "maas",
      "protocol": "openid-connect",
      "protocolMappers": [
        {
          "name": "sub",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-sub-mapper",
          "config": {
            "access.token.claim": "true",
            "introspection.token.claim": "true"
          }
        },
        {
          "name": "email",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "config": {
            "user.attribute": "email",
            "claim.name": "email",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        },
        {
          "name": "username",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "config": {
            "user.attribute": "username",
            "claim.name": "preferred_username",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        },
        {
          "name": "groups",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "config": {
            "user.attribute": "maas_groups",
            "claim.name": "groups",
            "jsonType.label": "String",
            "multivalued": "true",
            "aggregate.attrs": "true",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        },
        {
          "name": "maas-orgs",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "config": {
            "user.attribute": "maas_orgs",
            "claim.name": "https://redhat\\.com/maas/orgs",
            "jsonType.label": "JSON",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        },
        {
          "name": "MaaS audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "maas-cli",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        },
        {
          "name": "MaaS access token purpose",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-hardcoded-claim-mapper",
          "config": {
            "claim.name": "token_use",
            "claim.value": "access",
            "jsonType.label": "String",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "userinfo.token.claim": "false"
          }
        }
      ]
    }
  ],
  "defaultDefaultClientScopes": [
    "maas"
  ],
  "clients": [
    {
      "clientId": "maas-cli",
      "publicClient": true,
      "directAccessGrantsEnabled": true,
      "standardFlowEnabled": true,
      "defaultClientScopes": [
        "maas"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256"
      }
    }
  ]
}
