# Placeholder for the auth proxy's credentials Secret.
# The Deployment maas-consumer-auth-proxy reads these three keys through
# secretKeyRef. Replace every REPLACE_ME, save the file without the .example
# suffix outside this repository, and create the Secret before you apply the
# other manifests. Never commit the filled-in file.
#
#   OAUTH2_PROXY_CLIENT_ID      the OIDC client ID; on site-a it's tenant-demo
#                               (the AuthPolicy maas-consumer-ui-oidc accepts
#                               only tokens with azp == tenant-demo)
#   OAUTH2_PROXY_CLIENT_SECRET  that client's secret from Keycloak
#   OAUTH2_PROXY_COOKIE_SECRET  16, 24 or 32 random bytes, for example
#                               the output of: openssl rand -hex 16
apiVersion: v1
kind: Secret
metadata:
  name: maas-consumer-auth-proxy-creds
  namespace: openshift-ingress
  labels:
    app.kubernetes.io/part-of: maas-consumer-deploy
type: Opaque
stringData:
  OAUTH2_PROXY_CLIENT_ID: REPLACE_ME
  OAUTH2_PROXY_CLIENT_SECRET: REPLACE_ME
  OAUTH2_PROXY_COOKIE_SECRET: REPLACE_ME
